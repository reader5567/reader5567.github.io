---
// Site footer. `rows` lets a page add its own lines (posts add Title/Author/Published).
// The design credit appears on every page; the RSS, Links, Currently and
// Updated lines can be switched off with showSite={false} where they would
// be redundant.
//
// "Currently" is filled in at build time from Letterboxd, Wikipedia and
// Wikimedia Commons (see src/lib/). The webring links come from src/site.ts
// and are rendered only once the URLs are filled in.
import { site } from './site';
import { recentFilms } from './lib/letterboxd';
import { latestEdit } from './lib/wikipedia';
import { latestUpload } from './lib/commons';
const { rows = [], showSite = true } = Astro.props;
const built = new Date();
const [films, edit, upload] = await Promise.all([recentFilms(), latestEdit(), latestUpload()]);
const film = films[0];
const ring = site.indieWebRing;
const showRing = Boolean(ring.previous && ring.next);
---
<footer>
<div class="info">
{rows.map((r) => (
  <p><span class="infotype">{r.label}:</span> {r.href ? <a href={r.href}>{r.text}</a> : r.text}</p>
))}
<p><span class="infotype">Design:</span> <a href="https://cheap.urls.loan/">E. Beaton</a></p>
{showSite && <p><span class="infotype">Links:</span> <a href="/links">/links</a></p>}
{showSite && <p><span class="infotype">RSS:</span> <a href="/feed.xml">feed.xml</a></p>}
{showSite && <p><span class="infotype">Currently:</span> <span>Watched <a href={film.link}>{film.title}</a>. Edited <a href={edit.url}>{edit.title}</a>. Uploaded <a href={upload.pageUrl}>{upload.title.replace(/\.[a-z0-9]+$/i, '')}</a>.</span></p>}
{showRing && <p><span class="infotype">Webring:</span> <span><a href={ring.previous}>← previous</a> · <a href="https://xn--sr8hvo.ws/">🕸💍</a> · <a href={ring.next}>next →</a></span></p>}
{showSite && <p><span class="infotype">Updated:</span> {built.toDateString()}</p>}
</div>
<div class="siteinfo">
<p><a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> {built.getFullYear()}</p>
</div>
</footer>
