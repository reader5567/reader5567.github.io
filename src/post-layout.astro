---
import Layout from './layout.astro';
const { frontmatter } = Astro.props;
const formatDate = new Date(frontmatter.date.replace('Z', ''));
const rows = [
  { label: 'Title', text: frontmatter.title },
  { label: 'Author', text: 'Thadeus Smith' },
  { label: 'Published', text: formatDate.toDateString() },
];
---
<Layout
  title={`${frontmatter.title} – Thadeus Smith`}
  description={frontmatter.description ?? `${frontmatter.title}, by Thadeus Smith.`}
  rows={rows}
  showSite={false}
>
<article id="main">
  <h1 id="article-title">{frontmatter.title}</h1>
  <slot />
</article>
</Layout>
