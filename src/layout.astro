---
// Shared page shell: <head>, header, footer. Every page uses this so that
// site-wide things (RSS link, metadata, credit) live in exactly one place.
//
// Two switches for unusual pages:
// - noindex: asks search engines not to list the page. Pair it with
//   `noindex: true` in src/site.ts, which also leaves the page out of the
//   XML sitemap. (Do not block these pages in a robots.txt as well: a
//   crawler has to fetch a page to see this tag.)
// - bare: keeps the <head> and the page frame (the dotted background and
//   black border come from <body> in global.css) but leaves out the skip
//   link, header and footer. Used by /blank.
import './global.css';
import Header from './header.astro';
import Footer from './footer.astro';
import { accounts } from './lib/accounts';
const { title, description, rows = [], showSite = true, noindex = false, bare = false } = Astro.props;
// Accounts marked `head` in src/content/accounts/.
const relMe = (await accounts()).filter((a) => a.head);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="sitemap" href="/sitemap-index.xml" />
<!-- rel="me" links verify that these profiles and this site belong to the same person (used by IndieWeb sign-in). -->
{relMe.map((a) => <link rel="me" href={a.url}>)}
<title>{title}</title>
<slot name="head" />
</head>
<body>
{bare ? (
<slot />
) : (
<>
<a class="skip" href="#main">Skip to content</a>
<Header />
<slot />
<Footer rows={rows} showSite={showSite} />
</>
)}
</body>
</html>
