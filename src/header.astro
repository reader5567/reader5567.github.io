---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---
<header>
  <h1>Thadeus <br>Smith</h1>
  <nav>
    <a class={currentPath === "" ? "active" : ""} href="/">CV,</a>
    <a class={currentPath.startsWith("writing") ? "active" : ""} href="/writing">Words,</a>
    <a class={currentPath.startsWith("links") ? "active" : ""} href="/links">Links,</a>
    <a class={currentPath.startsWith("now") ? "active" : ""} href="/now">Now</a>
  </nav>
</header>
