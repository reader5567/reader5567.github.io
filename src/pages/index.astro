---
import Layout from '../layout.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';
import { descriptionHtml } from '../lib/markdown';
const { profile } = site;
const home = new URL('/', Astro.site).href;

// The résumé entries are Markdown files in src/content/resume/, one per
// position, in a folder per section. Each file's Properties hold the
// position, company, dates and order; its body is the description.
const entries = await getCollection('resume');
const sections = [
  ['experience', 'Experience'],
  ['education', 'Education'],
  ['volunteering', 'Volunteering'],
].map(([folder, title]) => ({
  title,
  entries: entries
    .filter((e) => e.id.startsWith(folder + '/'))
    .sort((a, b) => a.data.order - b.data.order)
    .map((e) => ({ ...e.data, description: descriptionHtml(e.rendered?.html ?? '') })),
}));
---
<Layout
  title="Thadeus Smith"
  description="Résumé of Thadeus Smith: Director of Education at Lumos Debate, speech and debate coach, editor at Champion Briefs, and Wikipedia administrator."
>
<style>
.section{
border-left: 6px solid;
padding-left: 0.5rem;
}
.resume{
display: flex;
flex-wrap:wrap;
justify-content: space-between;
margin: 0 0 2rem ;
padding: 0.25rem;
}
.position{
font-weight: 650;
padding: 0.1em 0;
flex-basis: 100%;
border-bottom: 3px solid black;
}
.date{
padding: 0.1em 0;
flex-shrink: 0;
flex-basis: 40%;
text-align: right;
}
.company{
padding: 0.1em 0;
flex-basis: 50%;
flex-grow: 1;
flex-shrink: 1;
margin-right: 1em;
}
.description{
flex-basis: 100%;
font-size: 85%;
opacity: 70%;
margin-top: 0.5rem;
}

@media screen and (max-width: 800px) {
  .section{
    border-left: 4px solid;
    padding-left: 0.25rem;
  }
}
</style>
<main id="main">
<!-- Representative h-card (https://microformats.org/wiki/representative-h-card-authoring).
     Invisible: <data> elements render nothing. The webring directory reads the
     name, photo and note from here; the visible version is on the Now page.
     Values come from `profile` in src/site.ts. -->
<div class="h-card">
<data class="p-name" value={profile.name}></data>
<data class="u-photo" value={new URL(profile.photo, Astro.site).href}></data>
<data class="p-note" value={profile.note}></data>
<data class="u-url u-uid" value={home}></data>
</div>

{sections.map((section) => (
<div class="section">
<h2>{section.title}</h2>
{section.entries.map((entry) => (
<p class="resume"><span class="position">{entry.position}</span><br>
<span class="company">{entry.company}</span> <span class="date">{entry.dates}</span>
{entry.description && <span class="description" set:html={entry.description} />}
</p>
))}
</div>
))}

</main>
</Layout>
